# ===============================================
# Akshbuilds Private API Server Environment Config
# ===============================================

# Port to listen on (default 3000)
PORT=3000

# Bind host (0.0.0.0 listens on all interfaces: localhost, LAN, and tunnels)
HOST=0.0.0.0

# Environment mode: development or production
NODE_ENV=production

# Admin Secret Key for viewing messages at /admin in the frontend
ADMIN_SECRET_KEY=change_this_to_a_secure_random_password

# Allowed Origins (Comma separated).
# Include your frontend production URL, Vercel URL, and local development URL.
# Examples:
# ALLOWED_ORIGINS=https://akshbuilds.tech,https://akshbuilds.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://akshbuilds.tech,https://akshbuilds.vercel.app
